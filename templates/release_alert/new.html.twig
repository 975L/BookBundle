{% extends 'layout.html.twig' %}
{% trans_default_domain 'book' %}

{# Defines specific variables #}
{% set title = 'label.release_alert_title'|trans({'%book%': book.title}) %}

{# Nothing here is worth finding through a search engine, and the page carries a session-bound form #}
{% set robots = 'noindex, follow' %}

{% block content %}
    <p class="text lead">{{ 'label.release_alert_intro'|trans({'%book%': book.title}) }}</p>

    {{ form_start(form) }}
        {# The errors bound to no field - an expired token, say - without which the page redisplays saying nothing #}
        {{ form_errors(form) }}
        {{ form_widget(form) }}
        <div class="text-center">
            <button type="submit" class="btn btn-primary">{{ 'label.release_alert_submit'|trans }}</button>
        </div>
    {{ form_end(form) }}

    {# The visitor has to be told what the address is kept for, how long, and how they get out of it, before they type it #}
    <p class="text text-muted">{{ 'text.release_alert_privacy'|trans }}</p>
{% endblock %}
