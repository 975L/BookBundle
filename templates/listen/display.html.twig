{% extends 'layout.html.twig' %}

{# Defines specific variables #}
{% set title = book.title %}
{% set summarySocialNetwork = book.summary %}
{% set ogImage = absolute_url(asset(book_cover(book) ?: "bundles/c975lbook/images/no-cover.webp")) %}
{% set locale = book.language %}

{# The book played: its pages turning along the recording when it carries their timecodes, its cover and the player alone otherwise - a few pages to leaf through before buying are no book to follow along (see Book::getCues()) #}
{% block content %}
    {% set audios = book_audio_medias(book) %}
    {# Mp3 first when there is one: the one format every browser plays #}
    {% set audio = audios|filter(media => media.mimeType == 'audio/mpeg')|first ?: audios|first %}
    {# The timecodes row can hold no file: nothing to follow then, as in the JSON (see ListenJsonController::book()) #}
    {% set followed = book.cues and book.cues.name and book.pages|length %}
    <div class="book-listen-page" lang="{{ book.language }}">
        {# A story heard far enough counts one listen, the site's and its apps' adding up: a ticket taken as it starts, handed back at the part the site sets, the server measuring the time itself (see UiBundle's PlayController and BookPlayDurationProvider) #}
        {% set playOwner = {ownerType: constant('c975L\\BookBundle\\Service\\BookFavoriteItemProvider::OWNER_TYPE'), ownerId: book.id} %}
        <div data-controller="ui-play-count" data-ui-play-count-url-value="{{ path('ui_play', playOwner) }}" data-ui-play-count-start-url-value="{{ path('ui_play_start', playOwner) }}">
            {% if followed %}
                <twig:c975LBook:Reader:Reader media="{{ book.pages }}" audio="{{ audio }}" cuesFile="{{ book.cues }}" id="listen-{{ book.id }}"/>
            {% else %}
                {% set cover = book_cover(book) %}
                <twig:c975LUi:Image:Image class="img-rounded box-shadow img-300" src="{{ asset(cover ?: 'bundles/c975lbook/images/no-cover.webp') }}" alt="{{ book.title }}" width="300" height="425"/>
                <twig:c975LUi:Audio:Audio src="{{ vich_uploader_asset(audio) }}" type="{{ audio.mimeType }}"/>
            {% endif %}
        </div>
        {# How many times it was heard, the site's and its apps' listens added up, once there are enough to say so (see BookPlaysExtension) #}
        {% set plays = book_plays(book) %}
        {% if plays %}
            <p class="text text-center text-muted">{{ 'label.listen_plays'|trans({'%count%': plays}, 'book', book_ui_locale(book.language)) }}</p>
        {% endif %}
        {# Everything the player needs again with no network: the recording, each page, their timecodes and the page-turn sound, plus the cover the downloads list shows (see UiBundle's Pwa:Download) #}
        {% set coverUrl = asset(book_cover(book) ?: 'bundles/c975lbook/images/no-cover.webp') %}
        {% set offlineUrls = [vich_uploader_asset(audio), coverUrl] %}
        {% if followed %}
            {% set offlineUrls = offlineUrls|merge(book.pages|map(page => vich_uploader_asset(page)))|merge([vich_uploader_asset(book.cues)]) %}
            {% if config('book-page-sound')|to_bool %}
                {% set offlineUrls = offlineUrls|merge([asset('bundles/c975lbook/sounds/page-turn.mp3')]) %}
            {% endif %}
        {% endif %}
        <twig:c975LUi:Pwa:Download name="book-listen-{{ book.id }}" title="{{ book.title }}" label="{{ 'label.listen_download'|trans({}, 'book', book_ui_locale(book.language)) }}" image="{{ coverUrl }}" urls="{{ offlineUrls }}"/>
        {% set bookPath = book_path('book_display', {'slug': book.slug}) %}
        {% if bookPath %}
            <p class="text-center"><a href="{{ bookPath }}">{{ 'label.listen_book_page'|trans({}, 'book', book_ui_locale(book.language)) }}</a></p>
        {% endif %}
    </div>
{% endblock %}
