{% extends 'layout.html.twig' %}

{# Defines specific variables #}
{% set title = serie.title %}
{% set summarySocialNetwork = serie.summary %}
{% set ogImage = absolute_url(asset(serie.covers|first != false ? serie.covers|first : "bundles/c975lbook/images/no-cover.webp")) %}

{# The hero carries the page's only h1, inside the container where the cover can stand beside it #}
{% block heading %}{% endblock %}

{% block content %}
    {# Read once, used twice: the summary offers exactly the sections rendered below it #}
    {% set sections = serie_sections(serie) %}
    {% set anchors = sections|column('anchor') %}

    {# Editor-only: the pencil UiBundle floats over anything carrying "data-block-edit-url" (see its assets/js/block-edit-overlay.js), leading to the very field the section is written in. Gated on the very role the edit screen asks for (see configureCrud()), the same one the blocks below go by: a pencil leading to a 403 would be worse than no pencil #}
    {% set editUrls = is_granted(config('site-role-editor')) ? serie_edit_urls(serie) : {} %}

    <div class="book-page" lang="{{ serie.language }}"{% if editUrls %} data-controller="blockEditOverlay" data-edit-label="{{ 'label.edit'|trans({}, 'ui') }}"{% endif %}>
        <twig:c975LBook:Breadcrumb serie="{{ serie }}" language="{{ serie.language }}"/>

        <twig:c975LBook:Serie:Hero serie="{{ serie }}" sections="{{ sections }}" editUrl="{{ editUrls.hero|default('') }}"/>
        {# No summary of anchors, as on a book's page: a serie holds a summary and the listing of what it tells, and the bar overflowed on a phone. The page therefore keeps its whole width (see sass/_book.scss, .book-page:has(> .book-page__toc)) #}

        <div class="book-page__sections">
            {# First of the column: the summary is the sentence the serie opens on, and it reads under the hero before any section #}
            <twig:c975LBook:Serie:Resume serie="{{ serie }}" editUrl="{{ editUrls.resume|default('') }}"/>
            {# No card around the items: what the serie holds is no section to be announced, it is what the page is read for - a title, the field searching in it, and the cards themselves #}
            {% if 'books' in anchors %}
                <section id="books" class="toc-target" lang="{{ serie.language }}">
                    <h2>{{ 'label.serie_books'|trans({}, 'book', serie.language) }}</h2>
                    <twig:c975LBook:Book:Search serie="{{ serie }}" heading="h3"/>
                    <twig:c975LBook:Book:Books books="{{ serie.books }}" displayMore="false" :editable="editUrls is not empty"/>
                </section>
            {% endif %}
            {% if 'strips' in anchors %}
                {# Every planche of the serie and not a handful: the list grows as the visitor scrolls (UiBundle's controller fetches the page the link below already points at), and without javascript that link is the ordinary link to the next page it looks like #}
                <section id="strips" class="toc-target" lang="{{ serie.language }}">
                    <h2>{{ 'label.strips'|trans({}, 'book', serie.language) }}</h2>
                    <twig:c975LBook:Strip:Search serie="{{ serie }}" heading="h3"/>
                    {# Under the field: search a word, or follow who says it - the two ways into a serie of planches #}
                    <twig:c975LBook:Strip:Characters characters="{{ characters|default([]) }}" serie="{{ serie }}" selected="{{ character|default('') }}" language="{{ serie.language }}" heading="h3"/>
                    <div data-controller="infiniteScroll">
                        {# The card above already carries the "strips" id the hero's button points at, so the listing writes none: the same id twice is invalid html #}
                        <twig:c975LBook:Strip:Cards strips="{{ strips }}" :infinite="true" :rating="true" :editable="editUrls is not empty" id=""/>

                        <div class="strip-list-footer">
                            {% if strips.getTotalItemCount > strips.getItemNumberPerPage %}
                                <p class="text text-center" aria-live="polite">{{ 'label.strips'|trans({}, 'book', serie.language) }} <span data-infiniteScroll-target="count">{{ strips|length }}</span> / {{ strips.getTotalItemCount }}</p>
                            {% endif %}
                            {% if strips.getCurrentPageNumber < strips.getPageCount %}
                                {# The paginator's own query is reused rather than rebuilt: whatever the visitor came with stays in it #}
                                <a
                                    href="{{ path(strips.route, strips.query({'p': strips.getCurrentPageNumber + 1})) }}#strips"
                                    rel="next"
                                    class="btn btn-secondary"
                                    data-infiniteScroll-target="next"
                                    data-action="click->infiniteScroll#load"
                                >{{ 'label.load_more'|trans({}, 'book', serie.language) }}</a>
                            {% endif %}
                        </div>
                    </div>
                </section>
            {% endif %}
            <twig:c975LUi:Blocks:Blocks blocks="{{ serie.blocks }}"/>
        </div>
    </div>

    {# The serie's structured data, whose hasPart is what says "tome 1 of 12" to a machine #}
    {% set jsonLd = serie_json_ld(serie, ogImage, serie_url(serie)) %}
    {% if jsonLd %}
        <script type="application/ld+json">{{ jsonLd }}</script>
    {% endif %}
{% endblock %}
