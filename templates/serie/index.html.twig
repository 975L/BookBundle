{% extends 'layout.html.twig' %}

{# Defines specific variables #}
{% set title = 'Nos séries' %}
{% set summarySocialNetwork = 'Liste des séries' %}

{# Editor-only: the pencil UiBundle floats over each card leads to this serie's screen (see assets/js/block-edit-overlay.js). Bound to the very role the screen asks for, a pencil leading to a 403 being worth less than no pencil #}
{% set canEdit = is_granted(config('site-role-editor')) %}

{% block content %}
    <h2>Toutes nos séries</h2>
    {# The listing grows instead of turning pages, as the catalog's does (see book/index.html.twig) #}
    <div id="series" data-controller="infiniteScroll{{ canEdit ? ' blockEditOverlay' : '' }}"{% if canEdit %} data-edit-label="{{ 'label.edit'|trans({}, 'ui') }}"{% endif %}>
        <twig:c975LBook:Serie:Series series="{{ series }}" :editable="canEdit" :infinite="true"/>

        <div class="text-center">
            {% if series.getTotalItemCount > series.getItemNumberPerPage %}
                <p aria-live="polite">{{ 'label.series'|trans({}, 'book') }} <span data-infiniteScroll-target="count">{{ series|length }}</span> / {{ series.getTotalItemCount }}</p>
            {% endif %}
            {% if series.getCurrentPageNumber < series.getPageCount %}
                {# The paginator's own query is reused rather than rebuilt: whatever the visitor came with stays in it #}
                <a
                    href="{{ path(series.route, series.query({'p': series.getCurrentPageNumber + 1})) }}#series"
                    rel="next"
                    class="btn btn-secondary"
                    data-infiniteScroll-target="next"
                    data-action="click->infiniteScroll#load"
                >{{ 'label.load_more'|trans({}, 'book') }}</a>
            {% endif %}
        </div>
    </div>
{% endblock %}
