{% extends 'layout.html.twig' %}

{# Defines specific variables. The word the site gives its catalog, the bundle's own otherwise (see BookCatalogProviderInterface) - and above both, the row an editor wrote for this url (see ConfigBundle's UrlMetadata), the layouts only reading a row for what the template left unsaid #}
{% set title = url_metadata_title(book_catalog_title()) %}
{% set summarySocialNetwork = url_metadata_summary(title) %}

{# Editor-only: the pencil UiBundle floats over each card leads to that book's own edit screen (see its assets/js/block-edit-overlay.js). Gated on the very role the edit screen asks for, a pencil leading to a 403 being worse than no pencil #}
{% set canEdit = is_granted(config('site-role-editor')) %}

{% block content %}
    <twig:c975LBook:Book:Explanation/>
    <twig:c975LBook:Book:Search/>
    {# The catalog grows instead of turning pages: UiBundle's controller fetches the page the link below already points to and appends its covers. Nothing here is written for it alone - without javascript, and for a crawler, that link is the ordinary link to the next page it looks like #}
    <div id="books" data-controller="infiniteScroll{{ canEdit ? ' blockEditOverlay' : '' }}"{% if canEdit %} data-edit-label="{{ 'label.edit'|trans({}, 'ui') }}"{% endif %}>
        <twig:c975LBook:Book:Books books="{{ books }}" :rating="true" :editable="canEdit" :infinite="true"/>

        <div class="text-center">
            {% if books.getTotalItemCount > books.getItemNumberPerPage %}
                {# What is on screen, which is what the controller writes back after each append: the figure would otherwise jump backwards on a page reached by its own link #}
                <p aria-live="polite">{{ 'label.books'|trans({}, 'book') }} <span data-infiniteScroll-target="count">{{ books|length }}</span> / {{ books.getTotalItemCount }}</p>
            {% endif %}
            {% if books.getCurrentPageNumber < books.getPageCount %}
                {# The paginator's own query is reused rather than rebuilt: whatever the visitor came with stays in it #}
                <a
                    href="{{ path(books.route, books.query({'p': books.getCurrentPageNumber + 1})) }}#books"
                    rel="next"
                    class="btn btn-secondary"
                    data-infiniteScroll-target="next"
                    data-action="click->infiniteScroll#load"
                >{{ 'label.load_more'|trans({}, 'book') }}</a>
            {% endif %}
        </div>
    </div>

    {# What this page of the catalog holds, in the order it prints it - the pages that follow publish their own, each numbering its cards from where this one stopped. The address is read before it is made absolute: a site serving this index but not the pages it lists answers null, and a level pointing nowhere is left out rather than published empty (see BookUrlExtension) #}
    {% set entries = [] %}
    {% for item in books %}
        {% set itemPath = book_path('book_display', {slug: item.slug}) %}
        {% if itemPath %}{% set entries = entries|merge([{name: item.title, url: absolute_url(itemPath)}]) %}{% endif %}
    {% endfor %}
    {% set jsonLd = book_item_list_json_ld(entries, (books.getCurrentPageNumber - 1) * books.getItemNumberPerPage) %}
    {% if jsonLd %}
        <script type="application/ld+json">{{ jsonLd|raw }}</script>
    {% endif %}
{% endblock %}
