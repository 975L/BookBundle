{% extends 'layout.html.twig' %}

{# Defines specific variables #}
{# The word the site gives its catalog, the bundle's own otherwise (see BookCatalogProviderInterface) #}
{% set title = book_catalog_title() %}
{% set summarySocialNetwork = title %}

{# Editor-only: the pencil UiBundle floats over each card leads to that book's own edit screen (see its assets/js/block-edit-overlay.js). Gated on the very role the edit screen asks for, a pencil leading to a 403 being worse than no pencil #}
{% set canEdit = is_granted(config('site-role-editor')) %}

{% block content %}
    <twig:c975LBook:Book:Explanation/>
    <twig:c975LBook:Book:Search/>
    <twig:c975LUi:Pagination:Pagination paginate="{{ books }}"/>
    <div{% if canEdit %} data-controller="blockEditOverlay" data-edit-label="{{ 'label.edit'|trans({}, 'ui') }}"{% endif %}>
        <twig:c975LBook:Book:Books books="{{ books }}" rating="true" :editable="canEdit"/>
    </div>
    <twig:c975LUi:Pagination:Pagination paginate="{{ books }}"/>
{% endblock %}