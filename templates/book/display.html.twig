{% extends 'layout.html.twig' %}

{# Defines specific variables #}
{% set title = book.title %}
{% set summarySocialNetwork = book.summary %}
{% set ogImage = absolute_url(asset(book.medias|first)) %}
{% set locale = book.language %}

{# The hero carries the page's only h1, inside the container where the cover can stand beside it - the layout's own would print the title a second time, above it #}
{% block title %}{% endblock %}

{% block content %}
    {# Read once, used twice: the summary offers exactly the sections rendered below it, and no section is rendered without an anchor pointing at it #}
    {% set sections = book_sections(book) %}
    {% set anchors = sections|column('anchor') %}

    <div class="book-page" lang="{{ book.language }}">
        <twig:c975LBook:Book:Hero book="{{ book }}" sections="{{ sections }}"/>
        <twig:c975LUi:Text:Toc entries="{{ sections }}" id="book-toc" class="book-page__toc"/>

        <div class="book-page__sections">
            {% if 'resume' in anchors %}<twig:c975LBook:Book:Resume book="{{ book }}"/>{% endif %}
            {% if 'apercu' in anchors %}<twig:c975LBook:Book:Videos book="{{ book }}"/>{% endif %}
            {% if 'extracts' in anchors %}<twig:c975LBook:Book:Extracts book="{{ book }}"/>{% endif %}
            {% if 'shops' in anchors %}<twig:c975LBook:Book:Shops book="{{ book }}"/>{% endif %}
            {% if 'podcasts' in anchors %}<twig:c975LBook:Book:Podcasts book="{{ book }}"/>{% endif %}
            {% if 'presse' in anchors %}<twig:c975LBook:Book:Presses book="{{ book }}"/>{% endif %}
            {% if 'marketing' in anchors %}<twig:c975LBook:Book:Marketings book="{{ book }}"/>{% endif %}
            {% if 'serie' in anchors %}<twig:c975LBook:Book:Serie book="{{ book }}"/>{% endif %}
            <twig:c975LBook:Book:Informations book="{{ book }}"/>
            <twig:c975LUi:Blocks:Blocks blocks="{{ book.blocks }}"/>
        </div>
    </div>

    {# The book's structured data, built by BookSnippetBuilder from the very fields displayed above #}
    {% set jsonLd = book_json_ld(book, ogImage, url('book_display', {'slug': book.slug})) %}
    {% if jsonLd %}
        <script type="application/ld+json">{{ jsonLd }}</script>
    {% endif %}
{% endblock %}
