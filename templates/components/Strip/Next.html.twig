{# <twig:c975LBook:Strip:Next previousNext="{{ previousNext }}" language="{{ language }}"/> - see Strip:Previous, the same arrow on the other side #}
{% if previousNext.next is not null %}
    <a href="{{ path('strip_display', {'slug': previousNext.next.slug}) }}"
        rel="next"
        class="strip-nav strip-nav--next"
        title="{{ previousNext.next.title }}"
        aria-label="{{ 'label.next_strip'|trans({}, 'book', language|default(null)) }} - {{ previousNext.next.title }}">&rsaquo;</a>
{% endif %}
