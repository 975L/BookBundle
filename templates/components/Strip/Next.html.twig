{# <twig:c975LBook:Strip:Next previousNext="{{ previousNext }}" language="{{ language }}"/> - see Strip:Previous, the same link on the other side of the row #}
{% if previousNext.next is not null %}
    <a href="{{ book_path('strip_display', {'slug': previousNext.next.slug}) }}"
        rel="next"
        class="strip-nav strip-nav--next"
        aria-label="{{ 'label.next_strip'|trans({}, 'book', language|default(null)) }} - {{ previousNext.next.title }}">
        <span class="strip-nav__title">{{ previousNext.next.title }}</span>
        <span class="strip-nav__glyph" aria-hidden="true">&rsaquo;</span>
    </a>
{% endif %}
