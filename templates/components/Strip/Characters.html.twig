{# <twig:c975LBook:Strip:Characters characters="{{ … }}" [serie="{{ serie }}"] [selected="slug"] [heading="h2"] [language] [editUrl]/> #}
{# "serie": the row narrows this serie's listing down to who speaks (an address of the form "/strips/x?character=maman"), the only listing of planches a site now serves #}
{# "heading": the title's level, the row being laid under a section's own when a serie carries it #}
{% if characters|length > 0 %}
    {% set heading = heading|default('h2') %}
    {% set serie = serie|default(null) %}
    {% set selected = selected|default('') %}
    <{{ heading }}>{{ 'label.characters'|trans({}, 'book', language|default(null)) }}</{{ heading }}>
    {# Where a chip leads: the serie's listing when the page holds one, nowhere otherwise - the name then reads without being a link #}
    <div class="flex-center"{% if editUrl|default('') %} data-block-edit-url="{{ editUrl }}"{% endif %}>
        {% for character in characters %}
            {% set url = serie ? serie_path(serie, {'character': character.slug}) ~ '#strips' : '' %}
            {# The face the character carries, uploaded on their own screen (see Character) - one not yet drawn falls back on the name alone, which is what every serie showed before any face existed #}
            {% set face = serie ? serie.getCharacter(character.slug)?.media : null %}
            {% if face and face.name %}
                <twig:c975LUi:Image:Link
                    label="{{ character.name|capitalize }}"
                    src="{{ face.name }}"
                    url="{{ url }}"
                    alt=""
                    class="strip-character{{ selected == character.slug ? ' strip-character--selected' : '' }}"
                    classLabel="strip-character__name"
                    width="{{ face.width }}"
                    height="{{ face.height }}"
                />
            {% elseif url %}
                <twig:c975LUi:Button:Button
                    label="{{ character.name|capitalize }}"
                    url="{{ url }}"
                    type="{{ selected == character.slug ? 'primary' : 'secondary' }}"
                    inline="true"
                />
            {% else %}
                <span class="badge">{{ character.name|capitalize }}</span>
            {% endif %}
        {% endfor %}

        {# The way back to the whole listing, beside the name it is filtered on: that name's own chip leads to the page being read, so without this the visitor has no way out of the filter #}
        {% if selected and serie %}
            <twig:c975LUi:Button:Button
                label="{{ 'label.strips'|trans({}, 'book', language|default(null)) }}"
                url="{{ serie_path(serie) }}#strips"
                type="secondary"
                inline="true"
            />
        {% endif %}
    </div>
{% endif %}
