{# <twig:c975LBook:Strip:Previous previousNext="{{ previousNext }}" language="{{ language }}"/> - the arrow laid over what the page shows (see Strip:Next for the other side) #}
{# The planche it leads to is named by the label and by the tooltip rather than printed beside the glyph: an arrow over a drawing has no room for a title, and a reader still has to know where the click lands #}
{% if previousNext.previous is not null %}
    <a href="{{ path('strip_display', {'slug': previousNext.previous.slug}) }}"
        rel="prev"
        class="strip-nav strip-nav--previous"
        title="{{ previousNext.previous.title }}"
        aria-label="{{ 'label.previous_strip'|trans({}, 'book', language|default(null)) }} - {{ previousNext.previous.title }}">&lsaquo;</a>
{% endif %}
