{# <twig:c975LBook:Breadcrumb serie="{{ strip.serie }}" [current="{{ strip.title }}"]/> - where a page sits, and the way back out of it. One component for the two pages, as GalleryBundle's own trail serves its three: "current" is left out on a serie's page, which then stops the trail one level earlier - a page prints the level it is on as text rather than linking to itself. The hierarchy is the gallery's: the series answer to their index and a book or a planche to the serie telling it, never to a pile holding every planche the site owns. "category" stands in place of a serie for the pages of the other cut of the catalog: the categories' index, then the category itself - the two hierarchies never meet, a book answering to its serie and to no category #}
{% props serie = null, category = null, current = '', language = null %}
{# Which index a serie answers to: the one listing its kind, the two sharing no serie (see SerieKind). A site serving neither has no first level to offer, and the entry is left out rather than pointing at a route that matches nothing (see BookRoutePrefix) #}
{% set isStripSerie = serie and serie.isStripSerie %}
{% set indexRoute = isStripSerie ? 'strip_index' : 'serie_index' %}
{% set indexLabel = isStripSerie ? 'label.strips_series' : 'label.series' %}
{% set hasIndex = config(isStripSerie ? 'book-route-strips' : 'book-route-series')|default('') is not empty %}
{% set hasCategoryIndex = config('book-route-categories')|default('') is not empty %}
<nav class="book-breadcrumb" aria-label="{{ 'label.breadcrumb'|trans({}, 'book', language) }}">
    {% if category %}
        {% if hasCategoryIndex %}
            <a href="{{ book_path('book_category_index') }}">{{ 'label.categories'|trans({}, 'book', language) }}</a>
            <span class="book-breadcrumb__separator" aria-hidden="true">&rsaquo;</span>
        {% endif %}
        <span class="book-breadcrumb__current" aria-current="page">{{ category.title }}</span>
    {% endif %}
    {% if serie %}
        {% if hasIndex %}
            <a href="{{ path(indexRoute) }}">{{ indexLabel|trans({}, 'book', language) }}</a>
            <span class="book-breadcrumb__separator" aria-hidden="true">&rsaquo;</span>
        {% endif %}
        {# A serie set aside is named but not linked: its own page answers 404, and the trail is where a book or a planche still holding on to it would offer that broken link (see Entity\Trait\HideableTrait) #}
        {% if current is empty or serie.hidden %}
            <span class="book-breadcrumb__current"{% if current is empty %} aria-current="page"{% endif %}>{{ serie.title }}</span>
        {% else %}
            <a href="{{ serie_path(serie) }}">{{ serie.title }}</a>
        {% endif %}
    {% endif %}
    {% if current is not empty %}
        {% if serie %}
            <span class="book-breadcrumb__separator" aria-hidden="true">&rsaquo;</span>
        {% endif %}
        <span class="book-breadcrumb__current" aria-current="page">{{ current }}</span>
    {% endif %}
</nav>
{# The same trail, said to a search engine, which prints it in place of the raw url. Emitted here rather than by each page: this is where the hierarchy is already resolved, levels included that a site serving no index or holding a hidden serie leaves out - and the builder drops a trail whose only level is the page itself #}
{% set trail = [] %}
{% if category and hasCategoryIndex %}
    {% set trail = [
        {name: 'label.categories'|trans({}, 'book', language), url: absolute_url(book_path('book_category_index'))},
        {name: category.title, url: absolute_url(app.request.pathinfo)}
    ] %}
    {% set jsonLd = book_breadcrumb_json_ld(trail) %}
    {% if jsonLd %}
        <script type="application/ld+json">{{ jsonLd|raw }}</script>
    {% endif %}
    {% set trail = [] %}
{% endif %}
{% if serie %}
    {% if hasIndex %}
        {% set trail = trail|merge([{name: indexLabel|trans({}, 'book', language), url: absolute_url(path(indexRoute))}]) %}
    {% endif %}
    {% if current is not empty and not serie.hidden and serie_path(serie) %}
        {% set trail = trail|merge([{name: serie.title, url: absolute_url(serie_path(serie))}]) %}
    {% endif %}
{% endif %}
{% if trail is not empty and current is not empty %}
    {% set trail = trail|merge([{name: current, url: absolute_url(app.request.pathinfo)}]) %}
    {% set jsonLd = book_breadcrumb_json_ld(trail) %}
    {% if jsonLd %}
        <script type="application/ld+json">{{ jsonLd|raw }}</script>
    {% endif %}
{% endif %}
