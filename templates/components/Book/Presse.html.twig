{# The stored address is already the player's, brought back to its platform's canonical form on save (see BookVideoNoCookieListener): nothing is built here #}
{% if presse.youtubeUrl %}
    <twig:c975LUi:Video:Iframe src="{{ presse.youtubeUrl }}" width="125"/>
    <p class="text-center">{{ presse.title }}</p>
{% elseif presse.name matches '/\.mp3$/' %}
    <div class="text-center width-150">
        <twig:c975LUi:Audio:Audio src="{{ asset(presse.name) }}" type="audio/mpeg"/>
        <p class="text-center">{{ presse.title }}</p>
    </div>
{% elseif presse.name matches '/\.mp4$/' %}
    <div class="text-center width-150">
        <twig:c975LUi:Video:Video src="{{ asset(presse.name) }}" type="video/mp4" width="125"/>
        <p class="text-center">{{ presse.title }}</p>
    </div>
{% else %}
    {% set imageSrc = presse.name|replace({'.pdf': '.webp'}) %}
    {% set imageSrc = asset_exists(imageSrc) ? imageSrc : "bundles/c975lbook/images/no-cover.webp" %}
    <twig:c975LUi:Image:Link label="{{ presse.title }}" alt="{{ presse.alt|default('') ?: presse.title }}" src="{{ asset(imageSrc) }}" url="{{ asset(presse.name) }}" class="img-thumbnail box-shadow img-125" width="150"/>
{% endif %}