{# <twig:c975LBook:Book:Extracts book="{{ book }}" [section="{{ section }}"] [editUrl=""] /> #}
{# The pages a reader leafs through before buying, handed to UiBundle's slider. A site whose extracts live in another bundle overrides this template in templates/bundles/c975LBookBundle/components/Book/Extracts.html.twig #}
{% props book, section = {}, editUrl = "" %}
{% set section = {anchor: 'extracts', label: 'label.read'|trans({}, 'book', book.language)}|merge(section) %}
{% set medias = book.extracts %}
{% if medias|length %}
    {% set body %}
        <twig:c975LUi:Slider:Slider media="{{ medias }}" id="slider" />
    {% endset %}
    {{ include('@c975LBook/book/_section.html.twig', {form: 'slider', book: book, section: section, editUrl: editUrl, body: body}) }}
{% endif %}
