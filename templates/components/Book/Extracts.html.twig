{# The extracts are the book's own medias, shown by UiBundle's slider. A site whose extracts live in another bundle overrides this template in templates/bundles/c975LBookBundle/components/Book/Extracts.html.twig #}
{% if book.medias|length %}
    <twig:c975LUi:Card:Card id="extracts" class="toc-target" lang="{{ book.language }}" title="{{ 'label.extracts'|trans({}, 'book', book.language) }}">
        <twig:c975LUi:Slider:Slider media="{{ book.medias }}" id="slider" />
    </twig:c975LUi:Card:Card>
{% endif %}
