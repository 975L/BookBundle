{# <twig:c975LBook:Book:Marketings book="{{ book }}" [section="{{ section }}"] [editUrl=""] /> #}
{% props book, section = {}, editUrl = "" %}
{% set section = {anchor: 'marketing', label: 'label.marketing'|trans({}, 'book', book.language)}|merge(section) %}
{% if book.marketings is not empty %}
    {% set body %}
        <div class="cards">
            {% for marketing in book.marketings %}
                <twig:c975LBook:Book:Marketing marketing="{{ marketing }}"/>
            {% endfor %}
        </div>
    {% endset %}
    {{ include('@c975LBook/book/_section.html.twig', {form: 'links', book: book, section: section, editUrl: editUrl, body: body}) }}
{% endif %}
