{% if book.marketings is not empty %}
    <twig:c975LUi:Card:Card id="marketing" class="toc-target" title="{{ 'label.marketing'|trans({}, 'book', book.language) }}" lang="{{ book.language }}">
        <div class="cards">
            {% for marketing in book.marketings %}
                <twig:c975LBook:Book:Marketing marketing="{{ marketing }}"/>
            {% endfor %}
        </div>
    </twig:c975LUi:Card:Card>
{% endif %}
