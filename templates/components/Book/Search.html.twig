{# <twig:c975LBook:Book:Search [serie="{{ serie }}"] [heading="h2"]/> - the field a catalog is searched from #}
{# Given a serie, the search is held inside it: the same field on a serie's page asks that serie alone, where the catalog's own asks every book #}
{% props serie = null, heading = 'h2' %}
<{{ heading }}>{{ 'label.book_search'|trans({}, 'book', serie ? serie.language : null) }}</{{ heading }}>
{{ component('BookSearch', {serieId: serie ? serie.id : null}) }}
