{# <twig:c975LBook:Book:Links links="{{ links }}" [book="{{ book }}"] [section="{{ section }}"] [id=""] [title=""] [lang=""] [editUrl=""] /> #}
{# One card of platform buttons, whatever the group: the icon, the label and the address all come from the link itself (see c975L\BookBundle\Entity\BookLink), so a platform added to the enum shows up here without touching this template #}
{% props links, book = null, section = {}, id = "", title = "", lang = "", editUrl = "" %}
{# "id"/"title" are what a caller naming the card itself hands over, the section standing above them when the site declared one #}
{% set section = {anchor: id, label: title}|merge(section) %}
{% if links|length > 0 %}
    {% set body %}
        <div class="flex-center text-center">
            {% for link in links %}
                <twig:c975LUi:Image:Link label="{{ book_link_label(link, lang ?: null) }}" src="{{ book_link_icon(link) }}" url="{{ book_link_url(link) }}" width="48" height="48" target="_blank"/>
            {% endfor %}
        </div>
    {% endset %}
    {{ include('@c975LBook/book/_section.html.twig', {form: 'links', book: book, section: section, lang: lang, editUrl: editUrl, body: body}) }}
{% endif %}
