{# <twig:c975LBook:Book:Presses book="{{ book }}" [section="{{ section }}"] [editUrl=""] /> #}
{% props book, section = {}, editUrl = "" %}
{% set section = {anchor: 'presse', label: 'label.presse'|trans({}, 'book', book.language)}|merge(section) %}
{% if book.presses is not empty %}
    {% set body %}
        <div class="cards">
            {% for presse in book.presses %}
                <twig:c975LBook:Book:Presse presse="{{ presse }}"/>
            {% endfor %}
        </div>
    {% endset %}
    {{ include('@c975LBook/book/_section.html.twig', {form: 'links', book: book, section: section, editUrl: editUrl, body: body}) }}
{% endif %}
