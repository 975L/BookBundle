{% if book.presses is not empty %}
    <twig:c975LUi:Card:Card id="presse" class="toc-target" title="{{ 'label.presse'|trans({}, 'book', book.language) }}" lang="{{ book.language }}">
        <div class="cards">
            {% for presse in book.presses %}
                <twig:c975LBook:Book:Presse presse="{{ presse }}"/>
            {% endfor %}
        </div>
    </twig:c975LUi:Card:Card>
{% endif %}
