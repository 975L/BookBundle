{% if book.videos is not empty %}
    <twig:c975LUi:Card:Card id="apercu" class="toc-target" title="{{ 'label.videos'|trans({}, 'book', book.language) }}" lang="{{ book.language }}">
        {% for video in book.videos %}
            <twig:c975LBook:Book:Video video="{{ video }}" language="{{ book.language }}"/>
        {% endfor %}
    </twig:c975LUi:Card:Card>
{% endif %}
