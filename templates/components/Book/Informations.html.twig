<twig:c975LUi:Card:Card id="informations" class="toc-target" title="{{ 'label.informations'|trans({}, 'book', book.language) }}" lang="{{ book.language }}">
    <div class="text-left">
        <p>
            {{ 'label.published_date'|trans({}, 'book', book.language) }} :
            <strong>
                {% if book.published == null %}
                    {{ 'label.to_be_published'|trans({}, 'book', book.language) }}
                {% elseif book.published|date("Ymd") > "now"|date("Ymd") %}
                    {{ 'label.to_be_published'|trans({}, 'book', book.language) }} ({{ book.published|date('d/m/Y') }})
                {% else %}
                    {{ book.published|date('d/m/Y') }}
                {% endif %}
            </strong>
        </p>
        <p>
            {{ 'label.author'|trans({}, 'book', book.language) }} :
            {% if book.authorWebsite %}
                <a href="{{ book.authorWebsite }}" title="Site de l'auteur {{ book.author }}" target="_blank">{{ book.author }}</a>
            {% else %}
                <strong>{{ book.author }}</strong>
            {% endif %}
        </p>
        {% if book.illustrator %}
            <p>{{ 'label.illustrator'|trans({}, 'book', book.language) }} : <strong>{{ book.illustrator }}</strong></p>
        {% endif %}
        {% set languageLabels = {'en': 'English', 'es': 'Español', 'fr': 'Français'} %}
        <p>{{ 'label.language'|trans({}, 'book', book.language) }} : <strong>{{ languageLabels[book.language]|default(book.language) }}</strong></p>
        <p>{{ 'label.format'|trans({}, 'book', book.language) }} : <strong>{{ book.format }}</strong></p>
        <p>{{ 'label.pages'|trans({}, 'book', book.language) }} : <strong>{{ book.pages }}</strong></p>
        <p>{{ 'label.age'|trans({}, 'book', book.language) }} : <strong>{{ book.age }}</strong></p>
        {# One line per edition, each with its own ISBN and its own release date - an edition with no date yet is announced rather than hidden #}
        {% if book.editions|length %}
            <h3>{{ 'label.editions'|trans({}, 'book', book.language) }}</h3>
            {% for edition in book.editions %}
                <p>
                    {{ book_edition_label(edition, book.language) }} :
                    <strong>{{ edition.isbn ? edition.isbn|isbn : "-" }}</strong>
                    {% if edition.published is null %}
                        ({{ 'label.to_be_published'|trans({}, 'book', book.language) }})
                    {% elseif not edition.released %}
                        ({{ 'label.to_be_published'|trans({}, 'book', book.language) }} {{ edition.published|date('d/m/Y') }})
                    {% endif %}
                </p>
            {% endfor %}
        {% endif %}
    </div>
</twig:c975LUi:Card:Card>