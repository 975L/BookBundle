{# <twig:c975LBook:Book:Informations book="{{ book }}" [section="{{ section }}"] [editUrl=""] /> #}
{% props book, section = {}, editUrl = "" %}
{% set section = {anchor: 'informations', label: 'label.informations'|trans({}, 'book', book.language)}|merge(section) %}
{% set body %}
    <div class="text-left">
        <p>
            {{ 'label.published_date'|trans({}, 'book', book.language) }} :
            <strong>
                {% if book.published == null %}
                    {{ 'label.to_be_published'|trans({}, 'book', book.language) }}
                {% elseif book.published|date("Ymd") > "now"|date("Ymd") %}
                    {{ 'label.to_be_published'|trans({}, 'book', book.language) }} ({{ book.published|date('d/m/Y') }})
                {% else %}
                    {{ book.published|date('d/m/Y') }}
                {% endif %}
            </strong>
        </p>
        {# The serie's author and illustrator stand for a book naming none of its own - the same reading BookSnippetBuilder gives the structured data, so the page and the snippet never name two different people. Their name leads to their own page now that they have one, not to their site off ours: that address is printed there, beside everything else they signed. Null when this site doesn't serve the family, the name then reading as plain text (see BookRoutePrefix) #}
        {% if book.effectiveAuthor %}
            <p>
                {{ 'label.author'|trans({}, 'book', book.language) }} :
                {% set authorPath = contributor_path(book.effectiveAuthor) %}
                {% if authorPath %}
                    <a href="{{ authorPath }}">{{ book.effectiveAuthor.name }}</a>
                {% else %}
                    <strong>{{ book.effectiveAuthor.name }}</strong>
                {% endif %}
            </p>
        {% endif %}
        {% if book.effectiveIllustrator %}
            <p>
                {{ 'label.illustrator'|trans({}, 'book', book.language) }} :
                {% set illustratorPath = contributor_path(book.effectiveIllustrator) %}
                {% if illustratorPath %}
                    <a href="{{ illustratorPath }}">{{ book.effectiveIllustrator.name }}</a>
                {% else %}
                    <strong>{{ book.effectiveIllustrator.name }}</strong>
                {% endif %}
            </p>
        {% endif %}
        {# Everyone else the book credits, one line per row in the order the back office lays them: the part they took is said in the site's own vocabulary, whose label only that vocabulary knows (see BookCustomizationProviderInterface::getContributorRoles()) #}
        {% for credit in book.contributors %}
            {% if credit.contributor %}
                <p>
                    {{ book_role_label(credit, book.language) }} :
                    {% set creditPath = contributor_path(credit.contributor) %}
                    {% if creditPath %}
                        <a href="{{ creditPath }}">{{ credit.contributor.name }}</a>
                    {% else %}
                        <strong>{{ credit.contributor.name }}</strong>
                    {% endif %}
                </p>
            {% endif %}
        {% endfor %}
        {# The endonym, read from the one place the bundle names languages (see BookTranslationExtension) rather than from a list of this template's own #}
        <p>{{ 'label.language'|trans({}, 'book', book.language) }} : <strong>{{ book_language_label(book.language) }}</strong></p>
        {% if book.age %}
            <p>{{ 'label.age'|trans({}, 'book', book.language) }} : <strong>{{ book.age }}</strong></p>
        {% endif %}
        {# The serie on one line and no longer in a card of its own: its cover and its summary spoke of another work. The hero names it, the informations lead to it - the path being null on a site serving books but no series (see BookUrlExtension), where the name stays written but is clickable nowhere #}
        {% if book.serie %}
            {% set seriePath = serie_path(book.serie) %}
            <p>
                {{ 'label.serie'|trans({}, 'book', book.language) }} :
                {% if seriePath %}
                    <a href="{{ seriePath }}">{{ book.serie.title }}</a>
                {% else %}
                    <strong>{{ book.serie.title }}</strong>
                {% endif %}
            </p>
        {% endif %}
        {# What the book is about, on the line following what it belongs to - the path being null on a site giving its categories no page of their own, where the names stay written but are clickable nowhere (see BookUrlExtension). Only the ones the site shows: a category set aside answers 404 #}
        {% set categories = book.shownCategories %}
        {% if categories|length %}
            <p>
                {{ 'label.categories'|trans({}, 'book', book.language) }} :
                {% for category in categories %}
                    {%- set categoryPath = book_category_path(category) -%}
                    {%- if categoryPath -%}<a href="{{ categoryPath }}">{{ category.title }}</a>{%- else -%}<strong>{{ category.title }}</strong>{%- endif -%}
                    {%- if not loop.last %}, {% endif -%}
                {% endfor %}
            </p>
        {% endif %}
        {# The other languages and the other versions of the same text: they read in the book's informations rather than in the hero, where three buttons already say what a reader came for. Each language by its endonym, each version by the title its publisher gave it: the bundle translates neither (see BookTranslationExtension and BookVersionExtension) #}
        {% set others = [] %}
        {% for translation in book_translations(book) %}
            {% set path = book_path('book_display', {'slug': translation.slug}) %}
            {% if path %}{% set others = others|merge([{label: book_language_label(translation.language), url: path}]) %}{% endif %}
        {% endfor %}
        {% if others|length %}
            <p>
                {{ 'label.translations'|trans({}, 'book', book.language) }} :
                {% for other in others %}<a href="{{ other.url }}">{{ other.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
            </p>
        {% endif %}
        {% set versions = [] %}
        {% for version in book_versions(book) %}
            {% set path = book_path('book_display', {'slug': version.slug}) %}
            {% if path %}{% set versions = versions|merge([{label: version.title, url: path}]) %}{% endif %}
        {% endfor %}
        {% if versions|length %}
            <p>
                {{ 'label.other_versions'|trans({}, 'book', book.language) }} :
                {% for version in versions %}<a href="{{ version.url }}">{{ version.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
            </p>
        {% endif %}
        {# One line per edition: its name, its ISBN, and what it is physically - the date is the book's and reads above. An edition holding neither ISBN, format nor pagination has nothing to say and drops out here #}
        {% set editions = book.editions|filter(edition => edition.isbn or edition.format or edition.pages) %}
        {% if editions|length %}
            <h3>{{ 'label.editions'|trans({}, 'book', book.language) }}</h3>
            {% for edition in editions %}
                {# The format and the pagination belong to the edition, not to the book: an epub has neither the size nor the page count of its paperback #}
                {% set details = [edition.format, edition.pages ? edition.pages ~ ' ' ~ 'label.pages'|trans({}, 'book', book.language)|lower : null]|filter(part => part) %}
                <p>
                    {{ book_edition_label(edition, book.language) }} :
                    {# No ISBN is a legitimate state, not a hole to fill: an audio sold on the site alone never needed a number, so its absence stays silent rather than showing a dash #}
                    {% if edition.isbn %}<strong>{{ edition.isbn|isbn }}</strong>{% if details|length %} - {% endif %}{% endif %}
                    {{ details|join(' - ') }}
                </p>
            {% endfor %}
        {% endif %}
    </div>
{% endset %}
{# Framed like the summary: the book's informations read in one go, and the frame sets them apart from the prose around them #}
{{ include('@c975LBook/book/_section.html.twig', {form: 'framed', book: book, section: section, editUrl: editUrl, body: body}) }}
