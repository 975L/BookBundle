{# <twig:c975LBook:Contributor:Resume contributor="{{ contributor }}" [editUrl=""] /> #}
{# The sentences they are introduced with, laid under the hero like a serie's (see Serie:Resume): neither title nor anchor, a summary being no destination to jump to #}
{% props contributor, editUrl = "" %}
{% if contributor.summary %}
    <div class="book-page__lead"{% if editUrl %} data-block-edit-url="{{ editUrl }}"{% endif %}>
        <div class="text lead">
            <twig:c975LUi:Text:Readmore text="{{ contributor.summary }}" id="contributor-summary"/>
        </div>
    </div>
{% endif %}
