{# The block interpolates "1"/"" where the pages pass "true"/"false" spelled out, and any non-empty string is true in Twig: the value is brought down to a boolean once here rather than tested at each call #}
{% set displayMore = displayMore|default(false)|to_bool %}
{# The rank of every title in the row, the cards' and the closing one's alike: <h3> under a titled section, <h2> straight under the page's <h1>. Matched, not interpolated: it writes a tag name #}
{% set level = level|default('') in ['h2', 'h3', 'h4'] ? level : 'h3' %}
{# "infinite" marks the list for UiBundle's infiniteScroll controller, which reads the page it fetches through this very attribute - only the listing that grows carries it, another listing sitting on the same page would otherwise answer in its place #}
<div class="cards book-cards book-cards--centered"{% if infinite|default(false) %} data-infiniteScroll-target="list"{% endif %}>
    {% for contributor in contributors %}
        <twig:c975LBook:Contributor:Contributor contributor="{{ contributor }}" :editable="editable|default(false)" level="{{ level }}"/>
    {% endfor %}
    {% if displayMore %}
        <article class="text-center width-200">
            <{{ level }} class="card-title book-card__title">{{ 'label.contributors_more'|trans({}, 'book') }}</{{ level }}>
            <twig:c975LUi:Button:Button label="{{ 'label.contributors'|trans({}, 'book') }}" url="{{ book_path('contributor_index') }}" />
        </article>
    {% endif %}
</div>
