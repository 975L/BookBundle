{# The block interpolates "1"/"" where the pages pass "true"/"false" spelled out, and any non-empty string is true in Twig: the value is brought down to a boolean once here rather than tested at each call #}
{% set displayMore = displayMore|default(false)|to_bool %}
{# "infinite" marks the list for UiBundle's infiniteScroll controller, which reads the page it fetches through this very attribute - only the listing that grows carries it, another listing sitting on the same page would otherwise answer in its place #}
<div class="cards book-cards"{% if infinite|default(false) %} data-infiniteScroll-target="list"{% endif %}>
    {% for serie in series %}
        <twig:c975LBook:Serie:Serie serie="{{ serie }}" :editable="editable|default(false)"/>
    {% endfor %}
    {% if displayMore %}
        <article class="text-center width-150">
            <h3 class="card-title">{{ 'label.series_more'|trans({}, 'book') }}</h3>
            <twig:c975LUi:Button:Button label="{{ 'label.series'|trans({}, 'book') }}" url="{{ path('serie_index') }}" />
        </article>
    {% endif %}
</div>