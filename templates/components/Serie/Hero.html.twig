{# <twig:c975LBook:Serie:Hero serie="{{ serie }}" [sections="{{ serie_sections(serie) }}"] />. Same opening as a book's, the serie's own logo standing where a book shows the serie it comes from. Carries the page's only h1 - serie/display.html.twig leaves the layout's title block empty #}
{% set sections = sections|default([]) %}
{% set anchors = sections|column('anchor') %}
{# The editor's pencil, added only when the caller passed a url (see book/display.html.twig). The serie opens on its background image when it carries one, like a book on its own: a real <img> and a veil above it, never a background-image - a nonce style-src covers no style attribute (see Book:Hero) #}
{% set background = serie.backgrounds|first != false ? serie.backgrounds|first : '' %}
<header class="book-hero book-page__hero{{ background ? ' book-hero--has-bg' : '' }}"{% if editUrl|default('') %} data-block-edit-url="{{ editUrl }}"{% endif %}>
    {% if background %}
        <img class="book-hero__bg" src="{{ asset(background) }}" alt="" aria-hidden="true" fetchpriority="high">
        <div class="book-hero__veil" aria-hidden="true"></div>
    {% endif %}

    {% set coverSrc = serie.covers|first != false ? serie.covers|first : "bundles/c975lbook/images/no-cover.webp" %}
    <img class="book-hero__cover" src="{{ asset(coverSrc) }}" alt="{{ 'label.cover'|trans({}, 'book', serie.language) }} - {{ serie.title }}" width="240" fetchpriority="high">

    <div class="book-hero__body">
        {% if serie.logos is not empty %}
            {# "height" matches --book-hero-logo-height so the box is reserved before the file lands; the stylesheet is what a site overrides #}
            <img class="book-hero__logo" src="{{ asset(serie.logos|first) }}" alt="{{ serie.title }}" height="96">
        {% endif %}

        <h1 class="book-hero__title">{{ serie.title }}</h1>

        {# Joined rather than separated by a fixed dash, the same reading as Book:Hero: a serie crediting nobody opened its line on a stray dash. The illustrator is only named when not already the author, failing which the line repeats one name twice. The number of books it holds is not said here any more: it stood over the very list printing them, and read "3 livres" through a word each site names its catalog with - one calling it "Toutes nos histoires" got "3 toutes nos histoires" (see label.books, which titles a catalog as much as it counts) #}
        {% set illustrator = serie.illustrator and (serie.author is null or serie.illustrator.id != serie.author.id) ? serie.illustrator : null %}
        {% set credits = [serie.author, illustrator]|filter(part => part) %}
        {% if credits|length %}
            <p class="book-hero__meta">{{ credits|join(' - ') }}</p>
        {% endif %}

        {# Same place as on a book and on a planche: under the line that qualifies what the page is about (see Book:Hero) #}
        {% if config('book-rating')|to_bool %}
            <twig:c975LUi:Rating:Rating ownerType="serie" ownerId="{{ serie.id }}" locale="{{ serie.language }}"/>
        {% endif %}

        <div class="book-hero__actions">
            {% if 'books' in anchors %}
                <twig:c975LUi:Button:Button label="{{ 'label.serie_books'|trans({}, 'book', serie.language) }}" url="#books" inline="true"/>
            {% endif %}
            {% if 'strips' in anchors %}
                <twig:c975LUi:Button:Button label="{{ 'label.strips'|trans({}, 'book', serie.language) }}" url="#strips" inline="true"/>
            {% endif %}
        </div>
    </div>
</header>
