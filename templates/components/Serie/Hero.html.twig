{# <twig:c975LBook:Serie:Hero serie="{{ serie }}" [sections="{{ serie_sections(serie) }}"] /> #}
{# Same opening as a book's, the serie's own logo standing where a book shows the serie it comes from. Carries the page's only h1 - serie/display.html.twig leaves the layout's title block empty #}
{% set sections = sections|default([]) %}
{% set anchors = sections|column('anchor') %}
<header class="book-hero book-page__hero">
    {% set coverSrc = serie.covers|first != false ? serie.covers|first : "bundles/c975lbook/images/no-cover.webp" %}
    <img class="book-hero__cover" src="{{ asset(coverSrc) }}" alt="{{ 'label.cover'|trans({}, 'book', serie.language) }} - {{ serie.title }}" width="240" fetchpriority="high">

    <div class="book-hero__body">
        {% if serie.logos is not empty %}
            <img class="book-hero__logo" src="{{ asset(serie.logos|first) }}" alt="{{ serie.title }}" height="48">
        {% endif %}

        <h1 class="book-hero__title">{{ serie.title }}</h1>

        <p class="book-hero__meta">
            {{ serie.author }}{% if serie.illustrator %} - {{ serie.illustrator }}{% endif %}
            {% if serie.books|length %} - {{ serie.books|length }} {{ 'label.books'|trans({}, 'book', serie.language)|lower }}{% endif %}
        </p>

        <div class="book-hero__actions">
            {% if 'books' in anchors %}
                <twig:c975LUi:Button:Button label="{{ 'label.serie_books'|trans({}, 'book', serie.language) }}" url="#books" inline="true"/>
            {% endif %}
        </div>
    </div>
</header>
