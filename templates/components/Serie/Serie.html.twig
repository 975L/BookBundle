{# "editable": the pencil leading to the serie's screen, drawn by UiBundle's overlay above what carries the url - the same condition as a book's card, a listing rendered outside the blocks cache #}
{% set editUrl = editable|default(false) and is_granted(config('site-role-editor')) ? serie_edit_url(serie) : null %}
<article class="width-150"{% if editUrl %} data-block-edit-url="{{ editUrl }}"{% endif %}>
    {% set cover = serie.covers|first %}
    {% set imageSrc = cover != false ? cover : "bundles/c975lbook/images/no-cover.webp" %}
    {# The cover's own alternative text, the serie's title when it carries none - same reading as a book's card #}
    <twig:c975LUi:Image:Link alt="{{ cover.alt|default('') ?: serie.title }}" src="{{ asset(imageSrc) }}" url="{{ serie_path(serie) }}" class="img-thumbnail box-shadow" width="150"/>
    <h3>{{ serie.title }}</h3>
    {% set languageLabels = {'en': 'English', 'es': 'Español', 'fr': 'Français'} %}
    <p class="text text-center small bold">({{ languageLabels[serie.language]|default(serie.language) }})</p>
</article>