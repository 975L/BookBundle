{# <twig:c975LBook:Store:Stores :items="items"/> #}
{# Where the catalog is sold, said once for the whole site. The very tile a book's own page prints its platforms in (see Book/Shops.html.twig and sass/_book.scss), fed by the block's stored items rather than by a book's links - the mark and the name come from the site's vocabulary, so a rail and a book page never name the same platform differently #}
{% props items = [], variant = '' %}
{# Matched, not interpolated: the value comes from stored block data and must not write any class name #}
{% set variant = variant|default('') == 'logos' ? ' book-stores--logos' : '' %}
<div class="flex-center text-center book-stores{{ variant }}">
    {% for item in items %}
        {% set kind = item.kind|default('') %}
        {% set url = item.url|default('') %}
        {% set icon = kind ? book_link_icon(kind) : null %}
        {# A platform whose vocabulary declares no mark has nothing to draw a tile with, so it is left out rather than printed as a broken image #}
        {% if kind and url and icon %}
            <twig:c975LUi:Image:Link label="{{ book_link_label(kind) }}" src="{{ icon }}" url="{{ book_link_url(url) }}" width="48" height="48" target="_blank"/>
        {% endif %}
    {% endfor %}
</div>
