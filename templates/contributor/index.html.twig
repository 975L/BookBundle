{% extends 'layout.html.twig' %}

{# Defines specific variables. The row an editor wrote for this url wins, these translated labels being its fallback (see ConfigBundle's UrlMetadata) #}
{% set title = url_metadata_title('label.contributors'|trans({}, 'book')) %}
{% set summarySocialNetwork = url_metadata_summary('label.contributors_summary'|trans({}, 'book')) %}

{# Editor-only: the pencil UiBundle floats over each card leads to this person's screen (see assets/js/block-edit-overlay.js). Bound to the very role the screen asks for, a pencil leading to a 403 being worth less than no pencil #}
{% set canEdit = is_granted(config('site-role-editor')) %}

{% block content %}
    <h2>{{ 'label.contributors_all'|trans({}, 'book') }}</h2>
    {# The listing grows instead of turning pages, as the catalog's does (see book/index.html.twig) #}
    <div id="contributors" data-controller="infiniteScroll{{ canEdit ? ' blockEditOverlay' : '' }}"{% if canEdit %} data-edit-label="{{ 'label.edit'|trans({}, 'ui') }}"{% endif %}>
        <twig:c975LBook:Contributor:Contributors contributors="{{ contributors }}" :editable="canEdit" :infinite="true"/>

        <div class="text-center">
            {% if contributors.getTotalItemCount > contributors.getItemNumberPerPage %}
                <p aria-live="polite">{{ 'label.contributors'|trans({}, 'book') }} <span data-infiniteScroll-target="count">{{ contributors|length }}</span> / {{ contributors.getTotalItemCount }}</p>
            {% endif %}
            {% if contributors.getCurrentPageNumber < contributors.getPageCount %}
                {# The paginator's own query is reused rather than rebuilt: whatever the visitor came with stays in it #}
                <a
                    href="{{ path(contributors.route, contributors.query({'p': contributors.getCurrentPageNumber + 1})) }}#contributors"
                    rel="next"
                    class="btn btn-secondary"
                    data-infiniteScroll-target="next"
                    data-action="click->infiniteScroll#load"
                >{{ 'label.load_more'|trans({}, 'book') }}</a>
            {% endif %}
        </div>
    </div>

    {# What this page of the people the catalog credits holds, in the order it prints it - the pages that follow publish their own, each numbering its cards from where this one stopped. The address is read before it is made absolute: a site serving this index but not the pages it lists answers null, and a level pointing nowhere is left out rather than published empty (see BookUrlExtension) #}
    {% set entries = [] %}
    {% for item in contributors %}
        {% set itemPath = contributor_path(item) %}
        {% if itemPath %}{% set entries = entries|merge([{name: item.name, url: absolute_url(itemPath)}]) %}{% endif %}
    {% endfor %}
    {% set jsonLd = book_item_list_json_ld(entries, (contributors.getCurrentPageNumber - 1) * contributors.getItemNumberPerPage) %}
    {% if jsonLd %}
        <script type="application/ld+json">{{ jsonLd|raw }}</script>
    {% endif %}
{% endblock %}
