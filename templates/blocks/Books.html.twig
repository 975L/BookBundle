{# Adapter for the dynamic Block system - the books are resolved live (see BookBlockExtension), the block itself only storing what to show and the head it shows it under #}
{% set books = book_block_books(max ?? null, random ?? false, categorySlug ?? null) %}
{% if books is not empty %}
    <twig:c975LBook:Listing:Section eyebrow="{{ eyebrow|default('') }}" title="{{ title|default('') }}" text="{{ content|default('') }}" background="{{ background|default('') }}" linkLabel="{{ linkLabel|default('') }}" linkUrl="{{ linkUrl|default('') }}" id="{{ anchor_id }}">
        <twig:c975LBook:Book:Books books="{{ books }}" displayMore="{{ displayMore ?? false }}" variant="{{ variant|default('') }}"/>
    </twig:c975LBook:Listing:Section>
{% endif %}
