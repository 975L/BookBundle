{% extends 'layout.html.twig' %}

{# Defines specific variables #}
{% set title = 'label.strips_series'|trans({}, 'book') %}
{% set summarySocialNetwork = 'label.strips_series_list'|trans({}, 'book') %}

{# Editor-only: the pencil UiBundle floats over each card leads to that serie's own edit screen (see its assets/js/block-edit-overlay.js). Gated on the very role the edit screen asks for, a pencil leading to a 403 being worse than no pencil #}
{% set canEdit = is_granted(config('site-role-editor')) %}

{# The series telling planches, not the planches themselves: those are read inside their serie, which lists them whole (see SerieController::display()) #}
{% block content %}
    <twig:c975LUi:Pagination:Pagination paginate="{{ series }}"/>
    <div{% if canEdit %} data-controller="blockEditOverlay" data-edit-label="{{ 'label.edit'|trans({}, 'ui') }}"{% endif %}>
        <twig:c975LBook:Serie:Series series="{{ series }}" :editable="canEdit"/>
    </div>
    <twig:c975LUi:Pagination:Pagination paginate="{{ series }}"/>
{% endblock %}
