{# Form theme for BookCrudController's collections - the editions of a book, edited in place inside the accordion EasyAdmin renders a collection as #}

{# One edition, in the "Informations techniques" tab. Same markup as EasyAdmin's own "collection_entry_row", whose classes field-collection.js needs, with a header naming the edition rather than printing the raw kind BookEdition::__toString() holds. Named "book_edition_row" after BookEditionType's own block prefix, which Twig looks up before EasyAdmin's generic block #}
{% block book_edition_row %}
    {% set allows_deleting_items = form_parent(form).vars.allow_delete|default(false) %}
    {# Opened on its own when it holds an error, which would otherwise sit in a panel nothing tells to unfold - same as EasyAdmin's own block #}
    {% set render_expanded = not form.vars.valid %}
    {# The edition's name, its ISBN and its size: what the book comes out under and nothing more. The date is the book's, the only one there is (see BookEdition) #}
    {% set title = value ? [book_edition_label(value), value.isbn, value.format]|filter(part => part)|join(' — ') : 'label.edition'|trans({}, 'book') %}

    <div class="field-collection-item {{ not form.vars.valid ? 'is-invalid' }}">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button {{ render_expanded ? '' : 'collapsed' }}" type="button" data-bs-toggle="collapse" data-bs-target="#{{ id }}-contents">
                    <twig:ea:Icon name="internal:chevron-right" class="form-collection-item-collapse-marker" />
                    {{ title }}
                </button>
                {% if allows_deleting_items and not disabled %}
                    <button type="button" class="btn btn-link btn-link-danger field-collection-delete-button"
                            title="{{ 'action.remove_item'|trans({}, 'EasyAdminBundle') }}">
                        <twig:ea:Icon name="internal:delete" />
                    </button>
                {% endif %}
            </h2>
            <div id="{{ id }}-contents" class="accordion-collapse collapse {{ render_expanded ? 'show' }}">
                <div class="accordion-body">
                    <div class="row">
                        {{ form_widget(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
